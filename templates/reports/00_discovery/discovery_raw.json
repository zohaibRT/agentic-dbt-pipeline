{
  "_file_meta": {
    "file": "discovery_raw.json",
    "purpose": "Structured raw discovery evidence exported from the warehouse before human-written summaries.",
    "why": "Creates an audit trail of what the database actually returned and which proofs support each claim.",
    "created_from_template": "templates/reports/00_discovery/discovery_raw.json",
    "required_on_every_discovery_run": true,
    "contains_secrets": false,
    "large_schema_rule": "For very large schemas, include every table with at least table_name and row_count. Add columns, keys, relationships, and sample_values only for included or priority tables.",
    "status_vocabulary": "PASS = evidence supports claim; WARN = documented limitation; FAIL = evidence contradicts claim; BLOCKED = cannot complete without user input; SKIPPED = intentionally not run",
    "how_to_read": "Read _file_meta, then run, scope, tables[], and queries_executed[]."
  },
  "run": {
    "generated_at": "<ISO-8601 timestamp>",
    "discovery_status": "PENDING",
    "dbt_profile_name": "<profile>",
    "adapter": "<adapter>",
    "source_schema": "<schema>"
  },
