          "is_candidate_measure": false,
          "is_candidate_date": false,
          "is_candidate_status": false,
          "is_sensitive": false
        }
      ],
      "candidate_keys": [
        "<column name>"
      ],
      "relationship_candidates": [
        {
          "child_column": "<column>",
          "parent_schema": "<schema>",
          "parent_table": "<table>",
          "parent_column": "<column>",
          "match_rate_percent": null,
          "orphan_count": null,
          "status": "PENDING",
          "proof_file": "reports/agent/00_discovery/sql_proofs/060_<child>_<parent>_relationship_check.sql"
        }
      ],
      "sample_values": {
        "<column_name>": [
          "<aggregate-safe sample value only>"
        ]
      },
      "proof_files": [
        "reports/agent/00_discovery/sql_proofs/010_<table>_row_count.sql"
      ]
    }
  ],
  "queries_executed": [
