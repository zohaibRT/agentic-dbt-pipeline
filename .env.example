# Copy this file to `.env` for each dbt project.
# The agent reads these non-secret settings before asking you questions.
# Prompt values still win if you provide a different value in chat.
#
# Keep secrets out of this file:
# - Do not add warehouse passwords.
# - Do not add API tokens or private keys.
# - Keep real credentials in ~/.dbt/profiles.yml or GitHub Secrets.

# Business/domain name for folder naming, docs, and modeling context.
# Examples: hospital, it_company, finance, retail
DBT_DOMAIN=<domain_name>

# dbt profile key from ~/.dbt/profiles.yml.
# This selects the warehouse connection, but does not store the password here.
DBT_PROFILE_NAME=<dbt_profile_name>

# Real raw/source schema in the warehouse that codegen should inspect.
# Example: if raw tables live in <raw_source_schema>.appointments, use <raw_source_schema>.
DBT_SOURCE_SCHEMA=<raw_source_schema>

# Friendly dbt source name used in source('source_name', 'table_name').
# Usually keep this close to the source schema name for clarity.
DBT_SOURCE_NAME=<dbt_source_name>

# GitHub repository name only, or local-only when you do not want a remote push.
# Examples: hospital-analytics, it-company-dbt, local-only
DBT_GITHUB_REPO_NAME=<repo_name_or_local_only>

# Skill-managed defaults:
# - Project name/root = derived from repo, source schema, source name, or domain
# - Layer schema prefix = DBT_SOURCE_NAME
# - Layer names = bronze, silver, gold
# - Commit behavior = ask before each phase commit
# - Push behavior = no push for local-only; otherwise ask before pushing
# - Materialization = production-friendly defaults
# - Agents Schema = enabled only when requested and supported by the warehouse
