# Copy this file to `.env` for each dbt project.
# The agent reads these non-secret settings before asking you questions.
# Prompt values still win if you provide a different value in chat.
#
# Keep secrets out of this file:
# - Do not add warehouse passwords.
# - Do not add API tokens or private keys.
# - Keep real credentials in ~/.dbt/profiles.yml or GitHub Secrets.

# Business/domain context for analytics and modeling.
# This is NOT used directly as the project folder or medallion folder path.
# Examples: hospital, real_estate, finance, retail
DBT_DOMAIN=

# Optional plain-English business/client description.
# Use this to explain what the client does, how the business works, and what
# decisions the analytics should support. Do not put secrets here.
# Example: Property sales and rental operations with leads, listings, agents, contracts, and payments.
DBT_BUSINESS_DESCRIPTION=

# dbt profile key from ~/.dbt/profiles.yml.
# This selects the warehouse connection, but does not store the password here.
DBT_PROFILE_NAME=

# Real raw/source schema in the warehouse that codegen should inspect.
# Example: if raw tables live in <raw_source_schema>.appointments, use <raw_source_schema>.
DBT_SOURCE_SCHEMA=

# Skill-managed defaults:
# - Project name/root = derived from source schema, explicit project override, repository, or profile metadata
# - Model folder slug = derived from the best stable project/source identifier, not directly from DBT_DOMAIN
# - dbt source name = derived from source schema unless overridden
# - Layer schema prefix = derived from explicit override, existing approved medallion schemas, or a descriptive source/project identifier
# - Layer names = bronze, silver, gold
# - Commit behavior = ask before each phase commit
# - GitHub behavior = local commits only unless you explicitly request a push
# - Materialization = production-friendly defaults
# - Agents Schema = enabled only when requested and supported by the warehouse

# Optional advanced overrides.
# Uncomment only when you intentionally want to override the agent-managed defaults.

# Explicit dbt project name, if the derived project name is not acceptable.
# DBT_PROJECT_NAME=

# Explicit dbt project folder/root, if different from DBT_PROJECT_NAME.
# DBT_PROJECT_ROOT=

# Explicit folder slug used under models/bronze, models/silver, and models/gold.
# Prefer leaving this blank so the agent can derive it from source/project evidence.
# DBT_PROJECT_SLUG=

# Explicit dbt source name used in source('<source_name>', '<table_name>').
# DBT_SOURCE_NAME=

# Explicit physical warehouse schema prefix, for example <prefix>_bronze.
# DBT_LAYER_SCHEMA_PREFIX=

# Materialization profile override. Typical values: prod or dev.
# DBT_MATERIALIZATION_PROFILE=

# Commit behavior override. Typical values: ask, auto_yes, or skip_all.
# DBT_COMMIT=

# GitHub push behavior override. Typical values: false, true, or ask.
# DBT_PUSH_TO_GITHUB=

# GitHub repository slug only, used only when push behavior is approved.
# DBT_GITHUB_REPO_NAME=

# Enable Agents Schema workflow only when requested and warehouse destination is supported.
# DBT_AUTO_AGENTS_SCHEMA=
