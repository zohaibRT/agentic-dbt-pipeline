table _Metrics
	lineageTag: __METRICS_LINEAGE_TAG__

	column MetricKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: [MetricKey]

	measure 'Template Measure' = 1
		formatString: 0

	partition _Metrics = calculated
		mode: import
		source = ROW("MetricKey", 1)

	annotation PBI_ResultType = Table
